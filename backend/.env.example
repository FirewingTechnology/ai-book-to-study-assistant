# Copy to .env and set a long random secret before deployment
APP_SECRET_KEY=replace-with-a-long-random-secret
# Optional. If omitted, the app uses clearly labeled sample/fallback content.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins; set to your deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
